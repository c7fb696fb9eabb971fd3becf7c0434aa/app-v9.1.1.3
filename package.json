{
  "name": "greendocs-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src config.ts config.test.ts vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,css,json,html}\" \".github/**/*.{yml,yaml,json}\" \".vscode/**/*.json\" package.json pnpm-workspace.yaml tsconfig.base.json .prettierrc.json --ignore-unknown"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
