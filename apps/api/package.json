{
  "name": "@greendocs/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "node --inspect=127.0.0.1:9229 --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@greendocs/content-schema": "workspace:*",
    "@greendocs/contracts": "workspace:*",
    "@google-cloud/firestore": "9.3.1",
    "@google-cloud/kms": "6.2.1",
    "@octokit/rest": "22.0.1",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
