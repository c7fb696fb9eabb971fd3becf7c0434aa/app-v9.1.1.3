# Local web and API origins
WEB_PORT=5173
API_PORT=8787
VITE_API_BASE_URL=
# Set WEB_ORIGINS only to override the local origin derived from WEB_PORT.

# Fixed server-side GitHub target; not client-selectable
GITHUB_OWNER=c7fb696fb9eabb971fd3becf7c0434aa
GITHUB_REPOSITORY=app-v9.1.1.3
GITHUB_BRANCH=main

# Cloud Run deployment values are provisioned separately; no credentials belong here.
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=
SESSION_KMS_KEY_NAME=
SESSION_COLLECTION=greendocs_sessions
PUBLISH_IDEMPOTENCY_COLLECTION=greendocs_publish_requests
AUTH_SESSION_TTL_SECONDS=900
# Set true only after the deployed API is protected by a configured edge rate-limit policy.
AUTH_EDGE_RATE_LIMITING_CONFIGURED=false
